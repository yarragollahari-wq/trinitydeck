<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trinity Deck — Build. Scale. Succeed.</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --deep-black: #121416;
            --graphite: #303235;
            --growth-blue: #0343D8;
            --royal-blue: #012F96;
            --midnight-blue: #011B52;
            --silver-gray: #8D929C;
            --soft-white: #DCDDE1;
            --white: #FFFFFF;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            background-color: var(--deep-black);
            color: var(--white);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 2rem 1.5rem;
            position: relative;
            overflow-x: hidden;
        }

        /* Glowing brand gradient background accents */
        body::before {
            content: '';
            position: absolute;
            top: -15%;
            left: 50%;
            transform: translateX(-50%);
            width: 700px;
            height: 700px;
            background: radial-gradient(circle, rgba(3, 67, 216, 0.22) 0%, rgba(1, 47, 150, 0.12) 45%, rgba(18, 20, 22, 0) 70%);
            border-radius: 50%;
            z-index: 0;
            pointer-events: none;
        }

        header {
            z-index: 1;
            width: 100%;
            max-width: 1100px;
            display: flex;
            justify-content: flex-start;
            align-items: center;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
        }

        .brand-logo img {
            height: 42px;
            width: auto;
            object-fit: contain;
        }

        .logo-text {
            font-weight: 800;
            font-size: 1.25rem;
            letter-spacing: -0.02em;
            color: var(--white);
        }

        .logo-text span {
            color: var(--growth-blue);
        }

        main {
            z-index: 1;
            text-align: center;
            max-width: 900px;
            width: 100%;
            margin: auto 0;
            padding: 3rem 0;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(141, 146, 156, 0.25);
            padding: 0.5rem 1rem;
            border-radius: 9999px;
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--soft-white);
            margin-bottom: 2rem;
            backdrop-filter: blur(10px);
        }

        .dot {
            width: 8px;
            height: 8px;
            background-color: var(--growth-blue);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--growth-blue);
        }

        h1 {
            font-size: clamp(2.5rem, 6vw, 4.25rem);
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.03em;
            margin-bottom: 1rem;
            background: linear-gradient(180deg, var(--white) 0%, var(--soft-white) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        p.tagline {
            font-size: clamp(1.2rem, 2.5vw, 1.5rem);
            color: var(--silver-gray);
            font-weight: 600;
            letter-spacing: -0.01em;
            line-height: 1.6;
            margin-bottom: 3.5rem;
        }

        /* Cal Embed Section Container */
        .calendar-section {
            background: rgba(48, 50, 53, 0.4);
            border: 1px solid rgba(141, 146, 156, 0.2);
            border-radius: 20px;
            padding: 1.5rem 1rem;
            margin-bottom: 3.5rem;
            backdrop-filter: blur(12px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .calendar-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--white);
            margin-bottom: 1rem;
        }

        .cal-wrapper {
            width: 100%;
            min-height: 650px;
            border-radius: 12px;
            overflow: hidden;
        }

        .contact-section-title {
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: var(--silver-gray);
            font-weight: 700;
            margin-bottom: 1.5rem;
        }

        /* Side-by-Side Cards Layout */
        .contacts-container {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            max-width: 760px;
            margin: 0 auto;
            width: 100%;
        }

        .contact-card {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.45rem;
            padding: 1.75rem 1.5rem;
            background: var(--graphite);
            border: 1px solid rgba(141, 146, 156, 0.2);
            border-radius: 16px;
            backdrop-filter: blur(10px);
            transition: all 0.25s ease;
        }

        .contact-card:hover {
            border-color: var(--growth-blue);
            transform: translateY(-3px);
            box-shadow: 0 12px 30px -10px rgba(3, 67, 216, 0.3);
        }

        .contact-name {
            font-weight: 700;
            font-size: 1.25rem;
            color: var(--white);
            margin-bottom: 0.25rem;
        }

        .contact-link {
            font-size: 0.9rem;
            color: var(--soft-white);
            font-weight: 500;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .contact-link:hover {
            color: var(--white);
            text-decoration: underline;
        }

        .contact-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.75rem;
            flex-wrap: wrap;
            justify-content: center;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.825rem;
            font-weight: 600;
            color: var(--white);
            background: rgba(3, 67, 216, 0.2);
            border: 1px solid var(--growth-blue);
            padding: 0.5rem 0.875rem;
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .action-btn:hover {
            background: var(--growth-blue);
            color: var(--white);
        }

        .whatsapp-btn {
            background: rgba(37, 211, 102, 0.15);
            border: 1px solid #25D366;
            color: #25D366;
        }

        .whatsapp-btn:hover {
            background: #25D366;
            color: var(--deep-black);
        }

        footer {
            z-index: 1;
            color: var(--silver-gray);
            font-size: 0.875rem;
            text-align: center;
        }

        @media (max-width: 680px) {
            body {
                padding: 1.5rem 1rem;
            }
            .contacts-container {
                flex-direction: column;
            }
            .contact-card {
                width: 100%;
            }
            .cal-wrapper {
                min-height: 500px;
            }
        }
    </style>
</head>
<body>

